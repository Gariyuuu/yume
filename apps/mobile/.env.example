# Copy to .env.local and fill in from your Supabase project settings.
# Expo loads .env files automatically (SDK 49+) — EXPO_PUBLIC_ vars are
# safe to ship in the client bundle, same trust level as the web app's
# NEXT_PUBLIC_ vars (anon key only, never the service role key).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used only by Settings' "Export my data" link, which opens the web app's
# /settings/export route in the system browser — that export logic lives
# in the Next.js app (apps/web/src/app/settings/export/route.ts), not as
# a portable Edge Function, so mobile hands off to it rather than
# duplicating it. Same origin as the web app's NEXT_PUBLIC_SITE_URL.
EXPO_PUBLIC_WEB_URL=
