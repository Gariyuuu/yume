# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local — see /.gitignore at the repo root.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your deployed URL (e.g. https://yume.vercel.app, or http://localhost:3000
# for local dev). Used for auth email redirect links and invite link
# generation — see src/app/(auth)/actions.ts and src/app/room/[roomId]/actions.ts.
NEXT_PUBLIC_SITE_URL=

# Used by supabase/functions AND by the game move Server Actions in this
# app (src/lib/supabase/service-role.ts) — never exposed to the client.
# See supabase/migrations/0013_games_rls.sql for why games specifically
# need this instead of the usual RLS-scoped client.
SUPABASE_SERVICE_ROLE_KEY=

# From your app at https://developer.spotify.com/dashboard — add
# {origin}/spotify/callback (e.g. http://127.0.0.1:3000/spotify/callback
# for local dev) as a Redirect URI on the app. Server-only, never exposed
# to the client — see src/lib/spotify/env.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# From https://console.cloud.google.com (enable "YouTube Data API v3").
# Only needed for the in-app keyword search box — pasting a YouTube URL
# works with no key at all. See src/app/room/[roomId]/youtube-actions.ts.
YOUTUBE_API_KEY=
